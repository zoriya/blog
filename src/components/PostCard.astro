---
import type { CollectionEntry } from "astro:content";

interface Props {
	post: CollectionEntry<"blogs" | "posts">;
}

const { post } = Astro.props;
const href = `/${post.collection}/${post.id}/`;
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 250));
const dateStr = post.data.date.toISOString().split("T")[0];
---

<div class="flex flex-wrap">
  <div class="mt-3 md:mt-0 w-full">
    <a href={href} class="no-underline">
      <div class="font-bold text-xl text-fg decoration-accent hover:underline hover:underline-offset-2">
        {post.data.title}
      </div>
    </a>
    <div class="text-sm text-fg-muted">
      <div class="flex flex-row flex-wrap items-center">
        <time datetime={dateStr}>{dateStr}</time>
        <span class="px-2 text-accent">&middot;</span>
        <span title="Reading time">{readingTime} min{readingTime > 1 ? "s" : ""}</span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="flex flex-row flex-wrap items-center mt-1">
          {post.data.tags.map((tag) => (
            <a
              href={`/tags/${tag}/`}
              class="mr-2 mt-1"
            >
              <span class="rounded-md border border-accent px-1 py-[1px] text-xs font-normal text-accent hover:bg-accent/10 transition-colors">
                {tag}
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
